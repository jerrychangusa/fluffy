# Copy to a private location outside this repository. Never commit real values.
# Deployment only; never pass the Primitive credential to the agent runtime.
PRIMITIVE_API_KEY=

# Support runtime, locally or on Blaxel.
ANTHROPIC_API_KEY=
AGENT_BRIDGE_SECRET=
TYPESAFE_API_KEY=
AGENT_STATE_DIR=/absolute/private/prescription-intake-state
SUPPORT_CUSTOMER_ACCESS=allowlist
SUPPORT_CUSTOMER_EMAIL=customer@example.com
SUPPORT_ORDER_ID=1042
AGENT_MODEL=claude-sonnet-5-5
AGENT_PORT=8000

# Jev runs in the trusted runtime and independently in the Primitive Function.
# Only ANTHROPIC_API_KEY reaches the Claude subprocess.
# Primitive injects its Function credential, ID and webhook secret.
# Mailbox identities, role routing and allowlists live in deployment/*.json.
