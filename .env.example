# Copy to a private location outside this repository. Never commit real values.
# Deployment credential; only forwarded to the trusted runtime when the
# read-only trace provider is explicitly enabled below. Never passed to Claude.
PRIMITIVE_API_KEY=

# Support runtime, locally or on Blaxel.
ANTHROPIC_API_KEY=
AGENT_BRIDGE_SECRET=
TYPESAFE_API_KEY=
AGENT_STATE_DIR=/absolute/private/prescription-intake-state
SUPPORT_CUSTOMER_ACCESS=allowlist
SUPPORT_CUSTOMER_EMAIL=customer@example.com
SUPPORT_ORDER_ID=1042
AGENT_MODEL=sonnet
AGENT_PORT=8000

# Optional private trace reader. Keep its bearer credential server-side.
TRACE_ENABLED=false
TRACE_OWNER_SUBJECT=
TRACE_OWNER_TOKEN=
TRACE_PROVIDER_ENABLED=false
# Defaults to the checked-out Git SHA during agent deployment.
SOURCE_REVISION=

# Jev runs in the trusted runtime and independently in the Primitive Function.
# Only ANTHROPIC_API_KEY reaches the Claude subprocess.
# Primitive injects its Function credential, ID and webhook secret.
# Mailbox identities, role routing and allowlists live in deployment/*.json.

# Deployer only: absolute directory containing your two deployment JSON files.
FLUFFY_CONFIG_DIR=/absolute/private/fluffy-instance
