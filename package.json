{
  "name": "agent-approval-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "check": "prettier --check .",
    "test": "node --test",
    "test:agent": "node --test src/agent/*.test.mjs agents/support/*.test.mjs scripts/lib/agent-archive.test.mjs",
    "test:approval": "node --test src/approval/*.test.mjs src/functions/*.test.mjs src/integrations/jev/*.test.mjs",
    "test:inbox": "node --test src/inbox/*.test.mjs src/functions/inbox.test.mjs",
    "build": "node scripts/build.mjs",
    "build:approval": "node scripts/build.mjs approval",
    "build:inbox": "node scripts/build.mjs inbox",
    "deploy:approval": "node scripts/deploy-approval.mjs",
    "deploy:inbox": "node scripts/deploy-inbox.mjs",
    "deploy:agent": "node scripts/deploy-agent.mjs",
    "start:support": "node agents/support/server.mjs",
    "test:gateway": "node --test src/gateway/*.test.mjs agents/support/*.test.mjs",
    "demo": "node --test --test-reporter=spec tests/intake-flow.test.mjs",
    "verify": "npm test && npm run check && npm run build"
  },
  "devDependencies": {
    "@blaxel/core": "0.3.30",
    "adm-zip": "0.6.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "pdf-lib": "1.17.1",
    "zod": "4.6.7"
  },
  "exports": {
    ".": "./src/gateway/gateway.mjs",
    "./claude": "./src/agent/tools.mjs",
    "./jev": "./src/integrations/jev/client.mjs"
  },
  "description": "Email questions and exact-action approvals for agents, built on Primitive.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerrychangusa/agent-approval-service.git"
  }
}
